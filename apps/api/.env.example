PORT=4000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/feather

# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# First owner account, created by `pnpm seed`
OWNER_NAME=Owner
OWNER_EMAIL=owner@example.com

# Browser apps allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Email (Nodemailer SMTP). If SMTP_HOST is empty, emails and OTPs are printed in the API console (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Feather <no-reply@example.com>"

# Photo storage: r2 (Cloudflare R2) or local (development only)
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=feather-photos
# Used to sign local file links when STORAGE_DRIVER=local
FILE_URL_SECRET=change-me-too
