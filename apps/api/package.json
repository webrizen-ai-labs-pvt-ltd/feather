{
  "name": "@feather/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import ./alias.js src/server.js",
    "start": "node --env-file-if-exists=.env --import ./alias.js src/server.js",
    "seed": "node --env-file-if-exists=.env --import ./alias.js src/scripts/seed.js",
    "test": "node --import ./alias.js --test \"src/**/*.test.js\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@feather/shared": "workspace:*",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "nodemailer": "^7.0.3",
    "zod": "^4.0.0"
  }
}
